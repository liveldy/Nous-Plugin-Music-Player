{
  "id": "app.nous.music-player",
  "name": "音乐播放器",
  "version": "1.0.0",
  "api": "1.3",
  "requiresHost": "1.2.0",
  "author": {
    "name": "Nelson",
    "url": "https://github.com/liveldy"
  },
  "description": "本机音频播放器：把文件加进来就播，顺序、单曲、随机三种模式，音量与今日听曲时长按账户记住。",
  "platforms": [
    "web",
    "windows-x64",
    "android-arm64"
  ],
  "permissions": [
    "storage"
  ],
  "entry": "ui/index.html",
  "repository": "liveldy/Nous-Plugin-Music-Player",
  "license": "MIT",
  "icon": "data:image/svg+xml;base64,",
  "navigation": [
    {
      "id": "player",
      "label": "播放",
      "icon": "home"
    }
  ],
  "defaultView": "player",
  "requiredMethods": [
    "storage.get",
    "storage.set"
  ],
  "optionalMethods": [],
  "resources": [
    "ui/index.html",
    "ui/style.css",
    "ui/app.js",
    "ui/nous-plugin.js",
    "ui/fonts/mona-sans-latin.woff2",
    "ui/fonts/geist-mono-latin.woff2",
    "ui/fonts/OFL-mona-sans.txt",
    "ui/fonts/OFL-geist-mono.txt"
  ],
  "changelog": [
    {
      "version": "1.0.0",
      "publishedAt": "2026-11-14",
      "changes": [
        "空壳起始：曲库从零开始，点「添加文件」或把文件拖进来，播放器只读本机音频。",
        "Web Audio 解码播放；宿主页面 CSP 禁止 <audio> 与网络，音频不离开这一页。",
        "顺序、单曲、随机三种模式，进度拖动、音量、空格与方向键，跟随宿主明暗主题。",
        "音量、模式与今日听曲时长写入插件存储，按账户隔离。"
      ]
    }
  ]
}

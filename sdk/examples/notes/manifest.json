{
  "id": "org.example.notes.dev",
  "name": "随手清单",
  "version": "1.0.0",
  "api": "1.3",
  "requiresHost": "1.2.0",
  "description": "公开SDK独立示例：按账户保存清单。",
  "platforms": [
    "web",
    "windows-x64",
    "android-arm64"
  ],
  "permissions": [
    "storage"
  ],
  "entry": "ui/index.html",
  "repository": "example-org/nous-notes",
  "license": "MIT",
  "navigation": [
    {
      "id": "notes",
      "label": "清单",
      "icon": "file-text"
    },
    {
      "id": "settings",
      "label": "设置",
      "icon": "settings"
    }
  ],
  "defaultView": "notes",
  "requiredMethods": [
    "storage.get",
    "storage.set",
    "navigation.go"
  ],
  "resources": [
    "ui/index.html",
    "ui/style.css",
    "ui/app.js",
    "ui/nous-plugin.js"
  ],
  "author": {
    "name": "Example Developer"
  },
  "changelog": [
    {
      "version": "1.0.0",
      "publishedAt": "2026-11-14",
      "changes": [
        "独立公开SDK示例；发布前替换作者、仓库与更新说明。"
      ]
    }
  ]
}

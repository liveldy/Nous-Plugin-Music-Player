{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/liveldy/Nous/main/sdk/schema/manifest.schema.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "api",
    "description",
    "platforms",
    "permissions",
    "entry",
    "repository",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:[.][0-9A-Za-z-]+)*)?(?:[+][0-9A-Za-z-]+(?:[.][0-9A-Za-z-]+)*)?$"
    },
    "api": {
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ]
    },
    "requiresHost": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 1000
        },
        "email": {
          "type": "string",
          "maxLength": 254
        }
      },
      "additionalProperties": false
    },
    "changelog": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "version",
          "publishedAt",
          "changes"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "maxLength": 60
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "additionalProperties": false
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "windows-x64",
          "android-arm64",
          "web"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "storage",
          "clipboard.write",
          "external.open",
          "native.runtime",
          "auth.external",
          "native.application",
          "native.bridge"
        ]
      }
    },
    "entry": {
      "type": "string"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "maxLength": 65536
    },
    "navigation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "icon": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "defaultView": {
      "type": "string"
    },
    "requiredMethods": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "host.info",
          "host.capabilities",
          "navigation.go",
          "storage.get",
          "storage.set",
          "storage.remove",
          "clipboard.write",
          "external.open",
          "runtime.status",
          "runtime.start",
          "runtime.stop",
          "runtime.invoke",
          "runtime.webLogin",
          "runtime.webLogin.cancel",
          "auth.external.begin",
          "auth.external.status",
          "auth.external.cancel"
        ]
      }
    },
    "optionalMethods": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "host.info",
          "host.capabilities",
          "navigation.go",
          "storage.get",
          "storage.set",
          "storage.remove",
          "clipboard.write",
          "external.open",
          "runtime.status",
          "runtime.start",
          "runtime.stop",
          "runtime.invoke",
          "runtime.webLogin",
          "runtime.webLogin.cancel",
          "auth.external.begin",
          "auth.external.status",
          "auth.external.cancel"
        ]
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "windows-x64": {
          "type": "object",
          "required": [
            "type",
            "entry",
            "asset"
          ],
          "properties": {
            "type": {
              "const": "jvm"
            },
            "entry": {
              "type": "string"
            },
            "mainJar": {
              "type": "string",
              "pattern": "^app/[A-Za-z0-9._-]+[.]jar$"
            },
            "asset": {
              "type": "object",
              "required": [
                "url",
                "sha256",
                "bytes"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://github[.]com/[^/]+/[^/]+/releases/download/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1073741824
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "android-arm64": {
          "type": "object",
          "required": [
            "type",
            "entry",
            "asset"
          ],
          "properties": {
            "type": {
              "const": "android-dex"
            },
            "entry": {
              "type": "string"
            },
            "minSdk": {
              "type": "integer",
              "minimum": 30
            },
            "asset": {
              "type": "object",
              "required": [
                "url",
                "sha256",
                "bytes"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://github[.]com/[^/]+/[^/]+/releases/download/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1073741824
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "native": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "api": {
            "const": "1.3"
          }
        }
      },
      "then": {
        "required": [
          "author",
          "requiresHost"
        ]
      }
    }
  ]
}
